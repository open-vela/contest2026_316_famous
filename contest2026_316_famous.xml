    Team repo manifest. Includes the full openvela base project set
    (openvela.xml in this same repo) and adds this team repo as a self-ref
    project, exposing its work-form subdirectories to openvela working-tree
    locations via <linkfile>. remote/default come from the included openvela.xml.
  -->
  <include name="openvela.xml"/>

  <project path="contest2026_316_famous" name="contest2026_316_famous">
    <linkfile src="app/led_blink"   dest="packages/demos/contest2026_316_led_blink"/>
    <linkfile src="app/button_test" dest="packages/demos/contest2026_316_button_test"/>
    <linkfile src="app/sysinfo"     dest="packages/demos/contest2026_316_sysinfo"/>
    <linkfile src="board/contest_board" dest="vendor/openvela/boards/contest2026_316_board"/>
  </project>
</manifest>
